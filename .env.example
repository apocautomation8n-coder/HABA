# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key

# URL base de la aplicación (para retorno de pasarelas de pago y webhooks)
NEXT_PUBLIC_APP_URL=https://haba.app

# Soporte HABA (WhatsApp en formato internacional sin signos, ej: 549351XXXXXXX)
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# Mercado Pago (T6 - Fin de prueba y suscripción)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_SUBSCRIPTION_AMOUNT=7000
MP_SUBSCRIPTION_CURRENCY=ARS
MP_SUBSCRIPTION_TITLE=Haba Mensual
# Id del plan unico "Haba Mensual" (si falta, se usa el unico plan activo de la cuenta)
MP_PREAPPROVAL_PLAN_ID=
# Clave para la tarea diaria que acredita cobros no avisados por el webhook (Vercel la manda sola)
CRON_SECRET=
# Public Key de produccion: formulario seguro de tarjeta de la suscripcion (tipo Config en Vercel)
NEXT_PUBLIC_MP_PUBLIC_KEY=
# Monto que muestra el formulario de tarjeta (mismo valor que MP_SUBSCRIPTION_AMOUNT)
NEXT_PUBLIC_MP_SUBSCRIPTION_AMOUNT=7000
# Ya no se usa: la suscripcion la crea HABA por usuaria
NEXT_PUBLIC_MP_SUBSCRIPTION_URL=
